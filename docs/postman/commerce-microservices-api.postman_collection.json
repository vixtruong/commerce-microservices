                "type": "text/javascript",
                "exec": [
                  "pm.test('No server error', () => pm.expect(pm.response.code).to.be.below(500));",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const tokens = pm.response.json(); pm.collectionVariables.set('accessToken', tokens.accessToken); pm.collectionVariables.set('refreshToken', tokens.refreshToken); }"
