{
  "AllowedHosts": "*",
  "Cors": { "Origins": [ "http://localhost:3000", "https://localhost:3000" ] },
  "Jwt": { "Issuer": "commerce-identity", "Audience": "commerce-clients" },
  "ReverseProxy": {
    "Routes": {
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/catalog/{**catch-all}" } },
      "cart": { "ClusterId": "cart", "Match": { "Path": "/api/cart/{**catch-all}" } },
      "orders": { "ClusterId": "ordering", "Match": { "Path": "/api/orders/{**catch-all}" } },
      "inventory": { "ClusterId": "inventory", "Match": { "Path": "/api/inventory/{**catch-all}" } },
      "payments": { "ClusterId": "payment", "Match": { "Path": "/api/payments/{**catch-all}" } },
      "shipping": { "ClusterId": "shipping", "Match": { "Path": "/api/shipping/{**catch-all}" } },
      "auth": { "ClusterId": "identity", "Match": { "Path": "/api/auth/{**catch-all}" } }
    },
    "Clusters": {
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "catalog-1": { "Address": "http://catalog-api-1:8080" }, "catalog-2": { "Address": "http://catalog-api-2:8080" } }
      },
      "cart": { "Destinations": { "cart-1": { "Address": "http://cart-api:8080" } } },
      "ordering": { "Destinations": { "ordering-1": { "Address": "http://ordering-api:8080" } } },
      "inventory": { "Destinations": { "inventory-1": { "Address": "http://inventory-api:8080" } } },
      "payment": { "Destinations": { "payment-1": { "Address": "http://payment-api:8080" } } },
      "shipping": { "Destinations": { "shipping-1": { "Address": "http://shipping-api:8080" } } },
      "identity": { "Destinations": { "identity-1": { "Address": "http://identity-api:8080" } } }
    }
  },
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } } }
}
