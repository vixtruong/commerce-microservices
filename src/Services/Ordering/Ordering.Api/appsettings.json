{
  "AllowedHosts": "*",
  "ConnectionStrings": { "Redis": "localhost:6379,abortConnect=false" },
  "Grpc": { "Cart": "http://localhost:5180", "Catalog": "http://localhost:5141" },
  "Jwt": { "Issuer": "commerce-identity", "Audience": "commerce-clients" },
  "RabbitMq": { "ExchangeName": "commerce.events", "DeadLetterExchangeName": "commerce.events.dlx", "MaxDeliveryAttempts": 5 },
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } } }
}
